<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
<!-- Global classes -->
    <preference for="Beehexa\WebhookPhp\Hook\HookStrategyInterface" type="Beehexa\Webhook\Hook\Beehexa"/>
    <type name="Beehexa\Webhook\Observer\EntityManagement">
        <arguments>
            <argument name="newEntityStrategies" xsi:type="array">
                <item name="customer" xsi:type="object">Beehexa\Webhook\Model\Entity\CustomerKeyStrategy</item>
                <item name="product" xsi:type="object">Beehexa\Webhook\Model\Entity\ProductKeyStrategy</item>
                <item name="order" xsi:type="object">Beehexa\Webhook\Model\Entity\OrderKeyStrategy</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="BeehexaWebhookVirtualLogger\VirtualDebug" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/beehexa_webhook.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="BeehexaWebhookVirtualLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">BeehexaWebhookVirtualLogger\VirtualDebug</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Beehexa\Webhook\Observer\Context">
        <arguments>
            <argument name="logger" xsi:type="object">BeehexaWebhookVirtualLogger</argument>
        </arguments>
    </type>
<!-- Global classes -->

    <virtualType name="ObserverCatalogProductUpdate" type="Beehexa\Webhook\Observer\Events\Update" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">product</argument>
        </arguments>
    </virtualType>
    <virtualType name="ObserverCatalogProductDelete" type="Beehexa\Webhook\Observer\Events\Delete" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">product</argument>
        </arguments>
    </virtualType>

    <virtualType name="ObserverCatalogCategoryUpdate" type="Beehexa\Webhook\Observer\Events\Update" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">category</argument>
        </arguments>
    </virtualType>
    <virtualType name="ObserverCatalogCategoryDelete" type="Beehexa\Webhook\Observer\Events\Delete" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">category</argument>
        </arguments>
    </virtualType>


    <virtualType name="ObserverCustomerEntitySaveBefore" type="Beehexa\Webhook\Observer\EAVBeforeSaveEntity">
        <arguments>
            <argument name="entityName" xsi:type="string">customer</argument>
        </arguments>
    </virtualType>
    <virtualType name="ObserverCustomerEntityUpdate" type="Beehexa\Webhook\Observer\Events\Update" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">customer</argument>
        </arguments>
    </virtualType>
    <virtualType name="ObserverCustomerEntityDelete" type="Beehexa\Webhook\Observer\Events\Delete" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">customer</argument>
        </arguments>
    </virtualType>

    <virtualType name="ObserverOrderEntitySaveBefore" type="Beehexa\Webhook\Observer\EAVBeforeSaveEntity">
        <arguments>
            <argument name="entityName" xsi:type="string">order</argument>
        </arguments>
    </virtualType>
    <type name="Beehexa\Webhook\Observer\Order\SubmitSuccess">
        <arguments>
            <argument name="entityName" xsi:type="string">order</argument>
        </arguments>
    </type>
    <type name="Beehexa\Webhook\Observer\Order\Update">
        <arguments>
            <argument name="entityName" xsi:type="string">order</argument>
        </arguments>
    </type>

    <virtualType name="ObserverInvoiceEntityUpdate" type="Beehexa\Webhook\Observer\Events\Update" shared="false">
        <arguments>
            <argument name="entityName" xsi:type="string">invoice</argument>
        </arguments>
    </virtualType>
</config>
